<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup and device-transfer rules. See backup_rules.xml for rationale:
   cookie jars cannot be decrypted on another device and the database contains
   URLs that should not be copied off-device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies" />
        <exclude domain="database" path="socialdl.db" />
        <exclude domain="database" path="socialdl.db-shm" />
        <exclude domain="database" path="socialdl.db-wal" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies" />
        <exclude domain="database" path="socialdl.db" />
        <exclude domain="database" path="socialdl.db-shm" />
        <exclude domain="database" path="socialdl.db-wal" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
